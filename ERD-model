Table regions {
  id SERIAL [pk]
  name TEXT
  code TEXT
  type TEXT
  parent_id INTEGER [ref: > regions.id]
}

Table units {
  id SERIAL [pk]
  code TEXT
  name TEXT
}

Table indicator_subtypes {
  id SERIAL [pk]
  name TEXT
}

Table indicators {
  id SERIAL [pk]
  name TEXT
  unit_id INTEGER [ref: > units.id]
  type TEXT
  theme TEXT
  subtype_id INTEGER [ref: > indicator_subtypes.id]
}

Table data_sources {
  id SERIAL [pk]
  name TEXT
  url TEXT
  organization TEXT
  date_collected DATE
}

Table indicator_values {
  id SERIAL [pk]
  indicator_id INTEGER [ref: > indicators.id]
  region_id INTEGER [ref: > regions.id]
  year INTEGER
  value NUMERIC
  source_id INTEGER [ref: > data_sources.id]
}

Table population_age_sex {
  id SERIAL [pk]
  region_id INTEGER [ref: > regions.id]
  year INTEGER
  age_code TEXT
  sex_code TEXT
  value NUMERIC
  source_id INTEGER [ref: > data_sources.id]
}

Table regional_programs {
  id SERIAL [pk]
  name TEXT
  level TEXT
  start_year INTEGER
  end_year INTEGER
  description TEXT
  status TEXT
  budget_total NUMERIC
}

Table program_regions {
  id SERIAL [pk]
  program_id INTEGER [ref: > regional_programs.id]
  region_id INTEGER [ref: > regions.id]
}

Table events {
  id SERIAL [pk]
  region_id INTEGER [ref: > regions.id]
  date DATE
  type TEXT
  severity NUMERIC
  description TEXT
  economic_loss NUMERIC
}
